# Paste your real Neon connection string into .env (not this file) — see README.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- SMS notifications (optional) ---
# Without these set, SMS sends are logged to the console instead of sent —
# nothing breaks, you just won't get real texts until these are filled in.
# See docs/FEATURES.md for setup and for swapping to a local Ethiopian
# SMS gateway (Afromessage/GeezSMS) instead of Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Dish photo uploads (optional) ---
# Get this by attaching a Vercel Blob store to your project:
# Vercel dashboard -> Storage -> Create Database -> Blob.
# Without it, staff can still paste an image URL directly in /admin.
BLOB_READ_WRITE_TOKEN=
